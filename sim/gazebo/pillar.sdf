<?xml version="1.0" ?>
<!-- One obstacle pillar. Radius 2 m, 14 m tall so it is unmissable from a
     10 m cruise altitude. Spawned repeatedly by spawn_course.sh at different
     poses; static so it never moves or falls over when clipped. -->
<sdf version="1.9">
  <model name="pillar">
    <static>true</static>
    <link name="link">
      <collision name="collision">
        <geometry><cylinder><radius>2.0</radius><length>14.0</length></cylinder></geometry>
      </collision>
      <visual name="visual">
        <geometry><cylinder><radius>2.0</radius><length>14.0</length></cylinder></geometry>
        <material>
          <ambient>0.62 0.26 0.08 1</ambient>
          <diffuse>0.85 0.36 0.11 1</diffuse>
          <specular>0.10 0.10 0.10 1</specular>
        </material>
      </visual>
    </link>
  </model>
</sdf>
